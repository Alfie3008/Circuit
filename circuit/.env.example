# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.
# None of these use the NEXT_PUBLIC_ prefix, so they are only readable by server routes.

# --- Anthropic (Phase 5) ---
# Leave empty to run without AI: Build with AI then only handles the example
# prompts (offline), and AI blocks give mock answers. Set it and restart
# `npm run dev` to switch to real Claude. Needs API credit on the account.
ANTHROPIC_API_KEY=
# Model that compiles natural language -> Circuit IR
CIRCUIT_COMPILE_MODEL=claude-sonnet-5-5
# Cheaper model used by runtime AI blocks (Ask AI, Run Agent, ...)
CIRCUIT_RUNTIME_MODEL=claude-haiku-4-5
# Required before deploying: password checked by the AI routes (empty = AI routes only accept localhost)
CIRCUIT_AI_PASSWORD=
# Build-with-AI requests per minute per client
CIRCUIT_AI_RATE_LIMIT=10
# AI-block requests per minute per client (a running program can make many)
CIRCUIT_AI_RUNTIME_RATE_LIMIT=60
# Total AI requests per day for the whole server (cost ceiling)
CIRCUIT_AI_DAILY_LIMIT=1000

# --- HTTP Request block (Phase 3) ---
# Off by default. Even when on, only GET to hosts in the allowlist is executed.
CIRCUIT_HTTP_GET_ENABLED=false
CIRCUIT_HTTP_ALLOWLIST=api.coingecko.com,en.wikipedia.org

# --- Solana read-only (Phase 6) ---
# Free key at helius.dev. Enables LIVE TOKEN mode, real wallet balances,
# and holder counts. Read-only: no keys that can sign.
HELIUS_API_KEY=
# Alternative without Helius (no holder counts): any Solana RPC URL, e.g. the
# public https://api.mainnet-beta.solana.com (slow, heavily rate-limited).
CIRCUIT_SOLANA_RPC_URL=
# SOL price used for market cap if the Jupiter price API can't be reached
CIRCUIT_SOL_USD=170
# Chain-read requests per minute per client
CIRCUIT_CHAIN_RATE_LIMIT=120

# --- Always-on server (Phase 7) ---
# Database. Supabase: Project Settings → Database → Connection string →
# "Transaction pooler" (port 6543). Tables are created automatically in their
# own `circuit` schema. Without it, local dev stores data in .circuit-data/.
DATABASE_URL=
# Signs login cookies. Required when deployed: 32+ random characters
# (e.g. run: openssl rand -hex 32).
CIRCUIT_SESSION_SECRET=
# Vercel Cron sends this to /api/cron/tick (Vercel sets the header for you).
CRON_SECRET=
# Instant chain events. With HELIUS_API_KEY + this + a public URL, CIRCUIT
# creates/updates its Helius webhook itself. Any long random string.
HELIUS_WEBHOOK_AUTH=
# Public address of the site, if not on Vercel (Vercel's is detected).
CIRCUIT_PUBLIC_URL=
# Safety limits for programs running on the server
CIRCUIT_RUNS_PER_MINUTE=60
CIRCUIT_RUN_TIME_MS=20000
# Most the whole server spends on AI per day (USD), across every coin. Each
# coin's own AI is paid from its creator fees (AI fuel: up to 90% of the fees
# it earned since going live), so there is no per-project setting.
CIRCUIT_AI_DAILY_USD=5
# Creator fee share of each trade used to measure AI fuel (pump.fun: 0.003)
CIRCUIT_CREATOR_FEE_RATE=0.003

# --- Proof on Solana (Phase 8) ---
# Receipt anchoring: every ~3 minutes the cron writes one memo transaction with
# the Merkle root of all new receipts. Needs a dedicated Solana keypair with a
# little SOL for fees (~0.000005 SOL per batch): the JSON array from
# `solana-keygen new -o anchor.json`, or its base58 secret key. Leave empty to
# keep receipts off chain (pages then say so). Never reuse a wallet that holds
# real funds, and never commit this.
CIRCUIT_ANCHOR_KEY=
